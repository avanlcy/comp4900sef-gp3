   ],
   "outputs": [
    "ReturnValue:bool"
   ],
   "pure": false,
   "category": "Dead Fire",
   "locals": [],
   "doc": "An alive, un-stowed, controller-owned character takes the item through GrantItem."
  },
  {
   "name": "Reset",
   "inputs": [],
   "outputs": [],
   "pure": false,
   "category": "Dead Fire",
   "locals": [],
   "doc": "Rolls a random type when asked, then shows and collides again."
  },
  {
   "name": "ApplyLook",
   "inputs": [],
   "outputs": [],
   "pure": false,
   "category": "Dead Fire",
   "locals": [],
   "doc": "The item's look (GameMode.GetItemLook of ItemType, bRandom): the crate's and the lid's stripe glow in its colour (EmissiveColor and Tint, Glow StripeGlow), the icon shows its texture in that colour, the beacon takes the colour. Makes the dynamic materials the first time (the same ones after)."
  },
  {
   "name": "ShowLook",
   "inputs": [
    "bShown:bool"
   ],
   "outputs": [],
   "pure": false,
   "category": "Dead Fire",
   "locals": [],
   "doc": "Shows or hides the crate and everything on it (Lid, Icon, Beacon)."
  },
  {
   "name": "BobIcon",
   "inputs": [],
   "outputs": [],
   "pure": false,
   "category": "Dead Fire",
   "locals": [],
   "doc": "The icon floats at IconHeight, bobbing IconBobHeight (peak to peak) on an IconBobPeriod cycle."
  },
  {
   "name": "PopLid",
   "inputs": [],
   "outputs": [],
   "pure": false,
   "category": "Dead Fire",
   "locals": [],
   "doc": "The lid pops off: it shows (the crate, icon and beacon are hidden) and TickLidPop moves it from now."
  },
  {
   "name": "TickLidPop",
   "inputs": [
    "DeltaSeconds:float"
   ],
   "outputs": [],
   "pure": false,
   "category": "Dead Fire",
   "locals": [],
   "doc": "While the lid pops: t = LidPopAge / LidPopSeconds; it rises LidPopHeight x (1 - (1 - t)^2), drifts LidPopDrift x t along +X and tilts LidPopTilt x t; at t = 1 it hides, and so does the collected actor."
  },
  {
   "name": "RestLid",
   "inputs": [],
   "outputs": [],
   "pure": false,
   "category": "Dead Fire",
   "locals": [],
   "doc": "Ends any pop and puts the lid back on the Crate's Lid socket (its rest transform)."
  }
 ],
